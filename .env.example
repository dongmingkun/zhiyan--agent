# ===== 默认：讯飞星火 Spark X2（本作品主模型，贴合挑战杯发榜单位，推荐）=====
# 密钥取「星火控制台 → 对应版本 → HTTP服务接口认证信息 → APIPassword」
# 模型 ServiceID 见 data/model_config.json 的 model_service_id 字段（提交时填写）
LLM_API_KEY=
LLM_BASE_URL=https://spark-api-open.xf-yun.com/v1
LLM_MODEL=spark-x

# ===== 备选：DeepSeek =====
# LLM_API_KEY=<你的密钥>
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# ===== 备选：OpenAI =====
# LLM_API_KEY=<你的密钥>
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ===== 备选：腾讯混元 =====
# LLM_API_KEY=<你的密钥>
# LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
# LLM_MODEL=hunyuan-turbo

# ===== 服务端配置（可选）=====
# 登录签名密钥（无状态 token 的 HMAC 密钥）。强烈建议在多实例部署时显式注入，
# 否则首次启动会自动生成 64 位随机密钥并写入本地 auth_secret.key（不随代码打包）。
# AUTH_SECRET=<你的随机密钥，如 python -c "import secrets;print(secrets.token_hex(32))">
# 允许跨域的前端域名，逗号分隔；同源部署可用 *
ALLOWED_ORIGINS=*
# 错题本数据库文件路径
DB_PATH=tutor.db

# ===== RAG 知识库（可选，默认开启）=====
# 是否启用检索增强生成：true 先检索知识库再让大模型据此作答
RAG_ENABLED=true
# 每次检索返回的知识点数量（默认 4）
RAG_TOP_K=4

# ===== 星火图片/多模态（可选，用于图片问答与 OCR）=====
# 取「星火控制台 → 图像理解/多模态 → 应用信息」
SPARK_IMAGE_APPID=
SPARK_IMAGE_API_KEY=
SPARK_IMAGE_API_SECRET=
SPARK_IMAGE_DOMAIN=general


# ===== 启动与首次初始化 =====
# run.py 与 Docker 默认端口一致；部署平台可覆盖。
PORT=8000
BACKUP_KEEP=10
# 仅在 admin 不存在时创建；不写密码到日志，不覆盖已有密码。
ADMIN_PASSWORD=
# 仅用于独立演示库；导入 data/seed_data.json 内历史演示账号与学习记录。
# 默认关闭，已有任何用户时绝不导入或清空数据库。
ENABLE_DEMO_SEED=false
